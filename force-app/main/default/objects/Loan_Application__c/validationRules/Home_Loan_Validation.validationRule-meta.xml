<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Home_Loan_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND( RecordType.DeveloperName = &quot;Home_Loan_RT&quot;, 
      OR( Requested_Amount__c  &lt; 250000, 
        Requested_Amount__c  &gt; 5000000))</errorConditionFormula>
    <errorDisplayField>Requested_Amount__c</errorDisplayField>
    <errorMessage>Please make sure the Requested Amount is Greater than R250 000 and Less than R5 Million</errorMessage>
</ValidationRule>
