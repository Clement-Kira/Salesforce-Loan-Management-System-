<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Repayment_When_Balance_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
      ISNEW(), 
      Loan_Application__r.Outstanding_Balance__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Cannot create a new repayment because the loan&apos;s outstanding balance is already below zero</errorMessage>
</ValidationRule>
