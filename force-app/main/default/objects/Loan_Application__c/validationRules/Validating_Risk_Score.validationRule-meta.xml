<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validating_Risk_Score</fullName>
    <active>true</active>
    <errorConditionFormula>OR( 
     Risk_Score__c  &lt; 0, 
     Risk_Score__c &gt; 10
)</errorConditionFormula>
    <errorDisplayField>Risk_Score__c</errorDisplayField>
    <errorMessage>The Risk Score cannot be Less than 1 or Greater than 10</errorMessage>
</ValidationRule>
