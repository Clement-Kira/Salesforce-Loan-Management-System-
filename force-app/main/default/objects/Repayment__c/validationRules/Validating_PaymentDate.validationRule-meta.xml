<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validating_PaymentDate</fullName>
    <active>true</active>
    <errorConditionFormula>Payment_Date__c &lt; (  Loan_Application__r.Disbursement__c  + 31 )</errorConditionFormula>
    <errorDisplayField>Payment_Date__c</errorDisplayField>
    <errorMessage>Payment Date must be at least 31 days after the Disbursement Date</errorMessage>
</ValidationRule>
