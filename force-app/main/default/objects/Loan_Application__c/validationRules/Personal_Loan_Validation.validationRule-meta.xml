<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Personal_Loan_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
     RecordType.DeveloperName = &quot;Personal_Loan_RT&quot;,
     OR( 
        Requested_Amount__c  &lt; 5000, 
         Requested_Amount__c  &gt; 500000) )</errorConditionFormula>
    <errorDisplayField>Requested_Amount__c</errorDisplayField>
    <errorMessage>Please make sure that the Requested Amount is Greater than R5000 and Less than R500000</errorMessage>
</ValidationRule>
